<?xml version="1.0" encoding="utf-8"?>

<!--
  The Windows installer.

  Per-user by default, into %LOCALAPPDATA%\Programs\Aitch: no administrator
  prompt, which is what a test build wants and what most people want anyway.
  The install directory goes on the user's PATH so `aitch` works from a
  terminal, which is the whole point of `set EDITOR=aitch`.

  Build it with packaging/windows/build.ps1, or let the release workflow do it.
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?define ProductName = "Aitch" ?>
  <?define Manufacturer = "TokenGoblin" ?>

  <Package Name="$(ProductName)"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           Scope="perUser"
           Compressed="yes"
           Language="1033"
           InstallerVersion="500"
           UpgradeCode="8f3c1b2a-6d54-4f19-9c8e-2a7b41d05e63">

    <!-- Scope="perUser" on its own leaves ALLUSERS unset, which is the
         pre-Installer-5 way of saying per-user. Windows then registers the
         product without a DisplayName, and Add/Remove Programs lists by
         DisplayName — so it installed, ran, and could not be uninstalled from
         Settings. This pair is the modern spelling: ALLUSERS=2 means "decide
         from MSIINSTALLPERUSER", and MSIINSTALLPERUSER=1 chooses per-user. -->
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />

    <!-- Installing 0.2 over 0.1 replaces it rather than sitting beside it. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(ProductName) is already installed. Uninstall it first if you meant to go back." />

    <MediaTemplate EmbedCab="yes" />

    <SummaryInformation Description="A text editor with nano's interaction model and VS Code's project model."
                        Manufacturer="$(Manufacturer)" />

    <!-- Generated from the editor's own dark theme by the make_icon example;
         see crates/aitch-ui/examples/make_icon.rs for the command. Note that
         ARPPRODUCTICON is what Add/Remove Programs shows beside the entry,
         and without it that row is blank. -->
    <Icon Id="AitchIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AitchIcon" />

    <!-- %LOCALAPPDATA%\Programs\Aitch -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(ProductName)" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="$(ProductName)" />
    </StandardDirectory>

    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Component Id="Executable" Guid="c41d7e08-9b32-4a6f-8d15-3e9f2c7a48b1">
        <File Id="AitchExe" Source="$(BinaryPath)" Name="aitch.exe" KeyPath="yes" />

        <!--
          On PATH, so `aitch notes.txt` works from a terminal and $EDITOR can
          name it. Per-user, so no administrator rights are needed; removed
          again on uninstall.
        -->
        <Environment Id="PathEntry"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="no" />
      </Component>

      <Component Id="Documentation" Guid="2b6a95c7-0f41-4d8e-b3a2-7c15e0498da6">
        <File Id="ReadmeFile" Source="$(DocsPath)\README.md" Name="README.md" KeyPath="yes" />
        <File Id="GuideFile" Source="$(DocsPath)\docs\guide.md" Name="guide.md" />
        <File Id="ConfigDocFile" Source="$(DocsPath)\docs\config.md" Name="config.md" />
        <File Id="KeymapDocFile" Source="$(DocsPath)\docs\keymap.md" Name="keymap.md" />
        <File Id="LicenseFile" Source="$(DocsPath)\LICENSE" Name="LICENSE" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="ShortcutFolder">
      <Component Id="StartMenuShortcut" Guid="6d0e83f5-71ba-4c92-a5d3-8f47b209ce14">
        <Shortcut Id="AitchShortcut"
                  Name="$(ProductName)"
                  Description="A text editor with nano's interaction model"
                  Target="[INSTALLFOLDER]aitch.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AitchIcon" />
        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\$(Manufacturer)\$(ProductName)"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="$(ProductName)" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
  </Package>
</Wix>
